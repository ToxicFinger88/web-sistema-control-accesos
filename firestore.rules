rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function existePerfil() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function perfilActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function usuarioActivo() {
      return existePerfil() && perfilActual().estado == 'activo';
    }

    function empresaActiva(empresaId) {
      return empresaId is string
        && empresaId != ''
        && exists(/databases/$(database)/documents/empresas/$(empresaId))
        && get(/databases/$(database)/documents/empresas/$(empresaId)).data.activa == true;
    }

    function esSuperadmin() {
      return usuarioActivo() && perfilActual().rol == 'superadmin';
    }

    function esAdminEmpresa() {
      return usuarioActivo() && perfilActual().rol == 'admin_empresa';
    }

    function esOperador() {
      return usuarioActivo() && perfilActual().rol == 'operador';
    }

    function perteneceAEmpresa(empresaId) {
      return usuarioActivo()
        && perfilActual().empresaId == empresaId
        && empresaActiva(empresaId);
    }

    function esPersonalDeEmpresa(empresaId) {
      return (esAdminEmpresa() || esOperador())
        && perteneceAEmpresa(empresaId);
    }

    match /usuarios/{usuarioId} {
      // Necesario para comprobar el estado al iniciar sesión,
      // incluso cuando el usuario está desactivado.
      allow get: if estaAutenticado()
        && (request.auth.uid == usuarioId || esSuperadmin());
      allow list: if esSuperadmin();
      // La administración de usuarios se realiza desde Cloud Functions.
      allow create, update, delete: if false;
    }

    match /empresas/{empresaId} {
      allow get, list: if esSuperadmin() || perteneceAEmpresa(empresaId);
      allow create, update: if esSuperadmin();
      allow delete: if false;

      match /configuracion/{documentoId} {
        allow read: if esSuperadmin() || perteneceAEmpresa(empresaId);
        allow write: if esSuperadmin();
      }
    }

    match /personasVisitable/{docId} {
      allow get, list: if esSuperadmin()
        || esPersonalDeEmpresa(resource.data.empresaId);

      allow create: if esAdminEmpresa()
        && perteneceAEmpresa(request.resource.data.empresaId)
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.estado == 'activo'
        && request.resource.data.nombre is string
        && request.resource.data.apellido is string;

      allow update: if esAdminEmpresa()
        && perteneceAEmpresa(resource.data.empresaId)
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.creadoPorUid == resource.data.creadoPorUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'apellido', 'estado',
          'fechaActualizacion', 'actualizadoPorUid'
        ])
        && request.resource.data.actualizadoPorUid == request.auth.uid
        && request.resource.data.estado in ['activo', 'inactivo']
        && request.resource.data.nombre is string
        && request.resource.data.apellido is string;

      // La web utiliza desactivación lógica, no eliminación física.
      allow delete: if false;
    }

    match /visitas/{docId} {
      allow get, list: if esSuperadmin()
        || (esAdminEmpresa() && perteneceAEmpresa(resource.data.empresaId))
        || (esOperador()
          && perteneceAEmpresa(resource.data.empresaId)
          && resource.data.creadoPorUid == request.auth.uid);

      // Compatible con MainActivity.java: empresaId y creadoPorUid.
      allow create: if (esAdminEmpresa() || esOperador())
        && perteneceAEmpresa(request.resource.data.empresaId)
        && request.resource.data.creadoPorUid == request.auth.uid;

      allow update: if (esAdminEmpresa() || esOperador())
        && perteneceAEmpresa(resource.data.empresaId)
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.creadoPorUid == resource.data.creadoPorUid
        && (esAdminEmpresa() || resource.data.creadoPorUid == request.auth.uid);

      allow delete: if (esAdminEmpresa() && perteneceAEmpresa(resource.data.empresaId))
        || (esOperador()
          && perteneceAEmpresa(resource.data.empresaId)
          && resource.data.creadoPorUid == request.auth.uid);
    }

    // Sin referencias en las fuentes web y Android examinadas.
    // No exponer datos OCR entre empresas mediante permisos genéricos.
    match /lecturasOCR/{docId} {
      allow read, write: if false;
    }
  }
}
