rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function perfilActual() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function usuarioActivo() {
      return estaAutenticado()
        && perfilActual().estado == 'activo';
    }


    function empresaActiva(empresaId) {
  return empresaId != null
    && empresaId != ''
    && exists(
      /databases/$(database)/documents/empresas/$(empresaId)
    )
    && get(
      /databases/$(database)/documents/empresas/$(empresaId)
    ).data.activa == true;
}

    function esSuperadmin() {
      return usuarioActivo()
        && perfilActual().rol == 'superadmin';
    }

    function esAdminEmpresa() {
      return usuarioActivo()
        && perfilActual().rol == 'admin_empresa';
    }

    function esOperador() {
      return usuarioActivo()
        && perfilActual().rol == 'operador';
    }

   function perteneceAEmpresa(empresaId) {
  return usuarioActivo()
    && perfilActual().empresaId == empresaId
    && empresaActiva(empresaId);
}

    match /usuarios/{usuarioId} {
      allow get: if estaAutenticado()
        && (
          request.auth.uid == usuarioId
          || esSuperadmin()
        );

      allow list: if esSuperadmin();

      allow create, update, delete: if false;
    }

  match /empresas/{empresaId} {
  allow read: if esSuperadmin()
    || perteneceAEmpresa(empresaId);

  allow create, update: if esSuperadmin();
  allow delete: if false;

  match /configuracion/{documentoId} {
    allow read: if esSuperadmin()
      || perteneceAEmpresa(empresaId);

    allow write: if esSuperadmin();
  }
}

    /*
     * Se conserva temporalmente para compatibilidad
     * con la aplicación Android actual.
     */
    match /personasVisitable/{docId} {
      allow read, write: if estaAutenticado();
    }

    /*
     * VISITAS
     *
     * superadmin:
     * - acceso global.
     *
     * admin_empresa:
     * - puede leer todas las visitas de su empresa.
     *
     * operador:
     * - solamente puede leer visitas de su empresa
     *   creadas por su propio UID.
     *
     * En las escrituras, empresaId y creadoPorUid
     * quedan protegidos para impedir suplantación.
     */
    match /visitas/{docId} {
      allow read: if esSuperadmin()
        || (
          esAdminEmpresa()
          && perteneceAEmpresa(
            resource.data.empresaId
          )
        )
        || (
          esOperador()
          && perteneceAEmpresa(
            resource.data.empresaId
          )
          && resource.data.creadoPorUid
            == request.auth.uid
        );

      allow create: if usuarioActivo()
        && !esSuperadmin()
        && perteneceAEmpresa(
          request.resource.data.empresaId
        )
        && request.resource.data.creadoPorUid
          == request.auth.uid;

      allow update: if usuarioActivo()
        && !esSuperadmin()
        && perteneceAEmpresa(
          resource.data.empresaId
        )
        && request.resource.data.empresaId
          == resource.data.empresaId
        && request.resource.data.creadoPorUid
          == resource.data.creadoPorUid
        && (
          esAdminEmpresa()
          || (
            esOperador()
            && resource.data.creadoPorUid
              == request.auth.uid
          )
        );

      allow delete: if usuarioActivo()
        && (
          (
            esAdminEmpresa()
            && perteneceAEmpresa(
              resource.data.empresaId
            )
          )
          || (
            esOperador()
            && perteneceAEmpresa(
              resource.data.empresaId
            )
            && resource.data.creadoPorUid
              == request.auth.uid
          )
        );
    }

    /*
     * Se conserva temporalmente sin cambios
     * mientras terminamos la integración OCR.
     */
    match /lecturasOCR/{docId} {
      allow read, write: if estaAutenticado();
    }
  }
}
